{
  "name": "carbon-magnate",
  "version": "2.0.0",
  "private": true,
  "description": "Juego 3D de minería orgánica con excavación por Marching Cubes, cuotas corporativas y cooperativo P2P WebRTC (navegador y Windows).",
  "author": "Carbon Magnate",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "concurrently -k -s first -n VITE,ELECTRON -c cyan,magenta \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "electron:preview": "npm run build:web && electron electron/main.cjs",
    "build:win": "npm run build:web && electron-builder --win portable"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.carbonmagnate.game",
    "productName": "Carbon Magnate",
    "executableName": "CarbonMagnate",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "artifactName": "CarbonMagnate-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "CarbonMagnate-${version}-portable.exe"
    }
  }
}
